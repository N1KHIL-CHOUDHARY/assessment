generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// User
// =========================

model User {
  id           Int      @id @default(autoincrement())
  username     String   @unique
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  topics Topic[]

  @@map("users")
}

// =========================
// Topic
// =========================

model Topic {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessions Session[]

  @@index([userId])
  @@map("topics")
}

// =========================
// Learning Session
// =========================

model Session {
  id        Int       @id @default(autoincrement())
  topicId   Int
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  interactions Interaction[]

  @@index([topicId])
  @@map("sessions")
}

// =========================
// Interaction
// =========================

model Interaction {
  id        Int @id @default(autoincrement())
  sessionId Int

  mode     InteractionMode
  question String
  response String

  feedback  Feedback?
  createdAt DateTime  @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@map("interactions")
}

// =========================
// Interaction Mode
// =========================

enum InteractionMode {
  LEARN
  CHALLENGE
  EXPLAIN
  VALIDATE
}

// =========================
// Feedback
// =========================

enum Feedback {
  HELPFUL
  NOT_HELPFUL
}
